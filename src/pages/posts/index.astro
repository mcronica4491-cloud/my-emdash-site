---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { getReadingTime } from "../../utils/reading-time";

// Sort in the database rather than in JS — lets the DB use its index on
// published_at and avoids a full-table scan on the client.
const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Single batched query for tags across all posts, instead of one
// getEntryTerms() call per post (which would be N round-trips).
// Bylines are already hydrated on entry.data.bylines.
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);

const postsWithTags = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
	bylines: post.data.bylines ?? [],
}));

const formatDate = (date: Date) =>
	date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});
---

<Base title="Reviews" description="Independent movie reviews, honestly argued">
	<div class="posts-page">
		<header class="page-header">
			<p class="archive-kicker">INDEPENDENT FILM JOURNAL</p>
			<h1 class="page-title">Reviews</h1>
			<p class="page-description">
				{posts.length} {posts.length === 1 ? "review" : "reviews"}. Honest takes, no studio notes.
			</p>
		</header>

		{
			posts.length === 0 ? (
				<p class="empty">No posts yet.</p>
			) : (
				<div class="posts-list">
					{postsWithTags.map(({ post, tags, bylines }) => (
						<article class="post-item">
							{post.data.featured_image ? (
								<a href={`/posts/${post.id}`} class="post-image" aria-label={`Read review: ${post.data.title}`}>
									<Image image={post.data.featured_image} />
								</a>
							) : (
								<div class="post-image-placeholder" aria-hidden="true" />
							)}
							<a href={`/posts/${post.id}`} class="post-link">
								<div class="post-meta">
									{bylines.length > 0 && (
										<>
											<div class="post-bylines">
												{bylines.slice(0, 2).map((credit, index) => (
													<>
														{index > 0 && <span class="byline-sep">,</span>}
														<span class="post-byline">
															{credit.byline.avatarMediaId && (
																<img
																	src={`/_emdash/api/media/file/${credit.byline.avatarMediaId}`}
																	alt={credit.byline.displayName}
																	class="post-byline-avatar"
																/>
															)}
															<span class="post-byline-name">
																{credit.byline.displayName}
															</span>
														</span>
													</>
												))}
												{bylines.length > 2 && (
													<span class="byline-more">+{bylines.length - 2}</span>
												)}
											</div>
											<span class="meta-dot" />
										</>
									)}
									{post.data.publishedAt && (
										<time>{formatDate(post.data.publishedAt)}</time>
									)}
									{post.data.publishedAt && <span class="meta-dot" />}
									<span>{getReadingTime(post.data.content)} min read</span>
									{typeof post.data.score === "number" && (
										<span class="post-rating"><strong>{post.data.score.toFixed(1)}</strong> / 10</span>
									)}
								</div>
								{post.data.film_title && (
									<p class="post-film-title">
										{post.data.film_title}{post.data.release_year && <span> ({post.data.release_year})</span>}
									</p>
								)}
								<h2 class="post-title" {...post.edit.title}>{post.data.title}</h2>
								{post.data.excerpt && (
									<p class="post-excerpt" {...post.edit.excerpt}>{post.data.excerpt}</p>
								)}
							</a>
							{tags.length > 0 && (
								<div class="post-tags">
									{tags.slice(0, 3).map((t) => (
										<a href={`/tag/${t.slug}`} class="post-tag">
											{t.label}
										</a>
									))}
								</div>
							)}
						</article>
					))}
				</div>
			)
		}
		<nav class="pagination" aria-label="Pagination">
			{cursor && <a href="/posts">First page</a>}
			{
				nextCursor && (
					<a href={`/posts?cursor=${encodeURIComponent(nextCursor)}`}>
						Next page
					</a>
				)
			}
		</nav>
	</div>
</Base>

<style>
	.posts-page {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		margin-bottom: var(--spacing-12);
	}

	.page-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.page-description {
		font-size: var(--font-size-lg);
		color: var(--color-muted);
	}

	.empty {
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	.posts-list {
		display: flex;
		flex-direction: column;
	}

	.post-item {
		padding: var(--spacing-8) 0;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.post-item:first-child {
		padding-top: 0;
	}

	.post-item:last-child {
		border-bottom: none;
	}

	.post-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.post-meta {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		margin-bottom: var(--spacing-2);
	}

	.meta-dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--color-muted);
	}

	/* Post bylines */
	.post-bylines {
		display: flex;
		align-items: center;
		gap: 2px;
	}

	.post-byline {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-1);
	}

	.post-byline-avatar {
		width: var(--avatar-size-sm);
		height: var(--avatar-size-sm);
		border-radius: 50%;
		object-fit: cover;
	}

	.post-byline-name {
		font-weight: 500;
		color: var(--color-text-secondary);
	}

	.byline-sep {
		color: var(--color-muted);
		margin-right: 2px;
	}

	.byline-more {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		margin-left: 2px;
	}

	.post-title {
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-heading);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-snug);
		margin-bottom: var(--spacing-2);
		transition: color var(--transition-fast);
	}

	.post-link:hover .post-title {
		color: var(--color-brand);
	}

	.post-excerpt {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
		margin-top: var(--spacing-4);
	}

	.post-tag {
		display: inline-block;
		padding: var(--tag-padding-y) var(--spacing-2);
		font-size: var(--font-size-xs);
		color: var(--color-text-secondary);
		background: var(--color-surface);
		border-radius: var(--radius);
		text-decoration: none;
		transition:
			color var(--transition-fast),
			background var(--transition-fast);
	}

	.post-tag:hover {
		color: var(--color-text);
		background: var(--color-border);
	}

	@media (max-width: 600px) {
		.posts-page {
			padding: var(--spacing-6) var(--spacing-4) var(--spacing-12);
		}

		.page-title {
			font-size: var(--font-size-3xl);
		}

		.post-title {
			font-size: var(--font-size-xl);
		}
	}

	.posts-page {
		max-width: var(--wide-width);
		padding: var(--spacing-12) var(--spacing-8) var(--spacing-16);
	}

	.page-header {
		padding-bottom: var(--spacing-8);
		border-bottom: 1px solid var(--color-text);
		margin-bottom: var(--spacing-4);
	}

	.archive-kicker {
		margin-bottom: var(--spacing-3);
		color: var(--color-brand);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
	}

	.page-title {
		font-family: var(--font-heading);
		font-size: 3.75rem;
		font-weight: 600;
		letter-spacing: 0;
	}

	.page-description {
		margin-top: var(--spacing-2);
		font-size: var(--font-size-base);
	}

	.posts-list {
		gap: var(--spacing-2);
	}

	.post-item {
		display: grid;
		grid-template-columns: 176px minmax(0, 1fr);
		gap: var(--spacing-6);
		padding: var(--spacing-6) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.post-image,
	.post-image-placeholder {
		grid-column: 1;
		grid-row: 1 / span 2;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: var(--color-bg-subtle);
	}

	.post-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 240ms ease;
	}

	.post-image:hover img {
		transform: scale(1.035);
	}

	.post-link {
		grid-column: 2;
		grid-row: 1;
	}

	.post-meta {
		flex-wrap: wrap;
		font-family: var(--font-mono);
		font-size: 0.68rem;
	}

	.post-rating {
		color: var(--color-brand);
	}

	.post-rating strong {
		font-family: var(--font-heading);
		font-size: var(--font-size-lg);
	}

	.post-film-title {
		margin: var(--spacing-3) 0 var(--spacing-1);
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		font-weight: 600;
	}

	.post-film-title span {
		color: var(--color-muted);
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		font-weight: 400;
	}

	.post-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-2xl);
		font-weight: 600;
		letter-spacing: 0;
	}

	.post-link:hover .post-title {
		color: var(--color-brand);
	}

	.post-tags {
		grid-column: 2;
		margin-top: 0;
	}

	.post-tag {
		background: var(--color-bg-subtle);
		border-radius: 2px;
		font-family: var(--font-mono);
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	@media (max-width: 600px) {
		.posts-page {
			padding: var(--spacing-8) var(--spacing-5) var(--spacing-12);
		}

		.page-title {
			font-size: 2.75rem;
		}

		.post-item {
			grid-template-columns: 92px minmax(0, 1fr);
			gap: var(--spacing-3);
			padding: var(--spacing-5) 0;
		}

		.post-image,
		.post-image-placeholder {
			grid-row: 1 / span 2;
		}

		.post-meta {
			gap: var(--spacing-1);
			font-size: 0.62rem;
		}

		.post-title {
			font-size: var(--font-size-lg);
		}

		.post-excerpt {
			font-size: var(--font-size-sm);
		}
	}
</style>
